  "item": [
    {
      "name": "1. Submit Travel Request - Valid Employee (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeName\": \"Charan K\",\n  \"employeeId\": \"EMP101\",\n  \"jobRole\": \"Employee\",\n  \"destination\": \"Bengaluru\",\n  \"purpose\": \"Client Architecture Workshop\",\n  \"travelStartDate\": \"2027-02-15\",\n  \"travelEndDate\": \"2027-02-18\",\n  \"estimatedCost\": 15000\n}"
        },
        "url": {
          "raw": "{{instance_url}}/services/apexrest/traveleasy/travel-requests",
          "host": ["{{instance_url}}"],
          "path": ["services", "apexrest", "traveleasy", "travel-requests"]
        }
      }
    },
