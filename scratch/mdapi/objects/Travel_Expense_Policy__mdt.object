<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configurable expense policy limits, receipt requirements, and review thresholds per role and category.</description>
    <label>Travel Expense Policy</label>
    <pluralLabel>Travel Expense Policies</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Allowed_Payment_Methods__c</fullName>
        <description>Comma-separated list of permitted payment methods (e.g. Corporate Card, Personal Card, Cash).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Allowed Payment Methods</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <description>Expense category name.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Category</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Daily_Limit__c</fullName>
        <description>Maximum cumulative allowable expense amount per employee per date in this category.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Daily Limit</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Active status of this policy configuration record.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Receipt_Required_Threshold__c</fullName>
        <description>Minimum amount at or above which an attached receipt proof is mandatory.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Receipt Required Threshold</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Requires_Manager_Review__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Flags whether expenses in this category unconditionally mandate dedicated manager review.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Requires Manager Review</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Role__c</fullName>
        <description>Target employee role (Employee or Manager).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Role</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Single_Transaction_Limit__c</fullName>
        <description>Maximum allowable limit for a single expense transaction.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Single Transaction Limit</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
</CustomObject>
