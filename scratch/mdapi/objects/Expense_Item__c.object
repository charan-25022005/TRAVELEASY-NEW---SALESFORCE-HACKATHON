<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>Accept</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>CancelEdit</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>Clone</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>Delete</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>Edit</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>List</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>New</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>SaveEdit</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>Tab</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>View</actionName>
        <type>Default</type>
    </actionOverrides>
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Line item representing an individual business travel expense.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Expense Item</label>
    <nameField>
        <displayFormat>ITEM-{00000}</displayFormat>
        <label>Expense Item Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Expense Items</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Amount__c</fullName>
        <description>Expense monetary amount.</description>
        <externalId>false</externalId>
        <label>Amount</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <description>Expense category adhering to TravelEasy standard categories.</description>
        <externalId>false</externalId>
        <label>Category</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Airfare</fullName>
                    <default>false</default>
                    <label>Airfare</label>
                </value>
                <value>
                    <fullName>Hotel &amp; Lodging</fullName>
                    <default>false</default>
                    <label>Hotel &amp; Lodging</label>
                </value>
                <value>
                    <fullName>Ground Transportation</fullName>
                    <default>false</default>
                    <label>Ground Transportation</label>
                </value>
                <value>
                    <fullName>Meals &amp; Food</fullName>
                    <default>false</default>
                    <label>Meals &amp; Food</label>
                </value>
                <value>
                    <fullName>Client Entertainment</fullName>
                    <default>false</default>
                    <label>Client Entertainment</label>
                </value>
                <value>
                    <fullName>Incidentals &amp; Miscellaneous</fullName>
                    <default>false</default>
                    <label>Incidentals &amp; Miscellaneous</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Details and business context of this specific expense item.</description>
        <externalId>false</externalId>
        <label>Description</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Expense_Report__c</fullName>
        <description>Parent expense report for this expense item.</description>
        <externalId>false</externalId>
        <label>Expense Report</label>
        <referenceTo>Expense_Report__c</referenceTo>
        <relationshipLabel>Expense Items</relationshipLabel>
        <relationshipName>Expense_Items</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Flag_Reason__c</fullName>
        <description>Brief summary of why this item was flagged by the control engine.</description>
        <externalId>false</externalId>
        <label>Flag Reason</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Flagged_For_Review__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Automatically set by SmartExpenseControlService if this item causes a policy exception.</description>
        <externalId>false</externalId>
        <label>Is Flagged For Review</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Payment_Method__c</fullName>
        <description>Payment method used for the expense transaction.</description>
        <externalId>false</externalId>
        <label>Payment Method</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Corporate Card</fullName>
                    <default>true</default>
                    <label>Corporate Card</label>
                </value>
                <value>
                    <fullName>Personal Card</fullName>
                    <default>false</default>
                    <label>Personal Card</label>
                </value>
                <value>
                    <fullName>Cash</fullName>
                    <default>false</default>
                    <label>Cash</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Receipt_Attached__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether an invoice or receipt proof is attached to this item.</description>
        <externalId>false</externalId>
        <label>Receipt Attached</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Receipt_Document_Id__c</fullName>
        <description>Salesforce ContentVersion or ContentDocument ID for uploaded receipt file.</description>
        <externalId>false</externalId>
        <label>Receipt Document Id</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Transaction_Date__c</fullName>
        <description>Date on which the expense was incurred.</description>
        <externalId>false</externalId>
        <label>Transaction Date</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Vendor__c</fullName>
        <description>Merchant, airline, hotel, or service provider name.</description>
        <externalId>false</externalId>
        <label>Vendor</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
