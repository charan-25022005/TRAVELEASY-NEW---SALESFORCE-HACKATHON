    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Auditable exception record raised by the Smart Expense Control Service for policy violations, missing receipts, duplicates, and overruns.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Expense Validation Exception</label>
    <nameField>
        <displayFormat>EXC-{00000}</displayFormat>
        <label>Exception Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Expense Validation Exceptions</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Details__c</fullName>
        <description>Detailed technical explanation of the policy limit breached, duplicate match criteria, or budget calculation.</description>
        <externalId>false</externalId>
        <label>Details</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Exception_Type__c</fullName>
        <description>Category of violation detected by Smart Expense Control Service.</description>
        <externalId>false</externalId>
        <label>Exception Type</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Policy Violation</fullName>
                    <default>false</default>
                    <label>Policy Violation</label>
                </value>
                <value>
                    <fullName>Missing Receipt</fullName>
                    <default>false</default>
                    <label>Missing Receipt</label>
                </value>
                <value>
                    <fullName>Potential Duplicate</fullName>
                    <default>false</default>
                    <label>Potential Duplicate</label>
                </value>
                <value>
                    <fullName>Budget Overrun</fullName>
                    <default>false</default>
                    <label>Budget Overrun</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Expense_Item__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Specific line item triggering this validation exception (if applicable).</description>
        <externalId>false</externalId>
        <label>Expense Item</label>
        <referenceTo>Expense_Item__c</referenceTo>
        <relationshipLabel>Validation Exceptions</relationshipLabel>
        <relationshipName>Validation_Exceptions</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Expense_Report__c</fullName>
        <description>Parent expense report for this validation exception.</description>
        <externalId>false</externalId>
        <label>Expense Report</label>
        <referenceTo>Expense_Report__c</referenceTo>
        <relationshipLabel>Validation Exceptions</relationshipLabel>
        <relationshipName>Expense_Exceptions</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Is_Blocking__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether this exception blocks parent expense report approval. Typically High and Critical exceptions that are not yet resolved.</description>
        <externalId>false</externalId>
        <label>Is Blocking</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Resolution_Comments__c</fullName>
        <description>Justification comments entered by reviewer upon resolving or waiving the exception.</description>
        <externalId>false</externalId>
        <label>Resolution Comments</label>
        <length>1000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Resolved_Date__c</fullName>
        <description>Timestamp when this exception was officially resolved or waived.</description>
        <externalId>false</externalId>
        <label>Resolved Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Reviewer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Manager or Finance user reviewing and resolving this exception.</description>
        <externalId>false</externalId>
        <label>Reviewer</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Reviewed_Exceptions</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Severity__c</fullName>
        <description>Risk severity level of the exception. High and Critical exceptions block report approval until resolved.</description>
        <externalId>false</externalId>
        <label>Severity</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Low</fullName>
                    <default>false</default>
                    <label>Low</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>false</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Critical</fullName>
                    <default>false</default>
                    <label>Critical</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Lifecycle status of the validation exception.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Open</fullName>
                    <default>true</default>
                    <label>Open</label>
                </value>
                <value>
                    <fullName>Under Review</fullName>
                    <default>false</default>
                    <label>Under Review</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Waived</fullName>
                    <default>false</default>
                    <label>Waived</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Resolved</fullName>
                    <default>false</default>
                    <label>Resolved</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
