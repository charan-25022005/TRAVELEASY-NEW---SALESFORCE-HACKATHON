<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>Determine if Approver is assigned or if approval routing is required.</description>
        <name>Check_Approver_Assignment</name>
        <label>Check Approver Assignment</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Approver Already Set</defaultConnectorLabel>
        <rules>
            <name>Approver_Is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Approver__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Approver_From_Employee</targetReference>
            </connector>
            <label>Approver Is Null</label>
        </rules>
    </decisions>
    <description>Orchestrates travel request submission, confirms approver routing, and prevents duplicate processing.</description>
    <environments>Default</environments>
    <interviewLabel>Travel Request Submission Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Travel Request Submission Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Assigns the employee's manager or employee as approver if missing.</description>
        <name>Assign_Approver_From_Employee</name>
        <label>Assign Approver From Employee</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Approver__c</field>
            <value>
                <elementReference>$Record.Employee__r.ManagerId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Approver_Assignment</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </filters>
        <object>Travel_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
