<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>Evaluate whether report has blocking exceptions to determine review path.</description>
        <name>Check_Blocking_Exceptions</name>
        <label>Check Blocking Exceptions</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Set_Under_Review_Route</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Blocking Exceptions</defaultConnectorLabel>
        <rules>
            <name>Has_Blocking_Exceptions</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Has_Blocking_Exceptions__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_Report_For_Exception_Review</targetReference>
            </connector>
            <label>Has Blocking Exceptions</label>
        </rules>
    </decisions>
    <description>Handles expense report submission, validates blocking exceptions, and routes report to appropriate review state.</description>
    <environments>Default</environments>
    <interviewLabel>Expense Report Submission Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Expense Report Submission Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Routes report to Exception Flagged state due to unresolved blocking violations.</description>
        <name>Flag_Report_For_Exception_Review</name>
        <label>Flag Report For Exception Review</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Exception Flagged</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Routes report to Under Review for authorized manager approval.</description>
        <name>Set_Under_Review_Route</name>
        <label>Set Under Review Route</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Under Review</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Blocking_Exceptions</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </filters>
        <object>Expense_Report__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
