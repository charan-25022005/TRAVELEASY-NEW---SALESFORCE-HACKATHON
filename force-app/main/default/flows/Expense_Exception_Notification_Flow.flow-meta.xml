<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>Checks if Reviewer is already populated or needs to be inherited from the parent report approver.</description>
        <name>Check_Reviewer_Assignment</name>
        <label>Check Reviewer Assignment</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Reviewer Already Assigned</defaultConnectorLabel>
        <rules>
            <name>Reviewer_Is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Reviewer__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Parent_Report_Approver</targetReference>
            </connector>
            <label>Reviewer Is Null</label>
        </rules>
    </decisions>
    <description>Dispatches notification and assigns reviewer when a High or Critical expense exception is detected.</description>
    <environments>Default</environments>
    <interviewLabel>Expense Exception Notification Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Expense Exception Notification Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Assigns reviewer from the parent expense report or travel request approver.</description>
        <name>Assign_Parent_Report_Approver</name>
        <label>Assign Parent Report Approver</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Reviewer__c</field>
            <value>
                <elementReference>$Record.Expense_Report__r.Approver__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Reviewer_Assignment</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Severity__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </filters>
        <filters>
            <field>Severity__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <object>Expense_Validation_Exception__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
